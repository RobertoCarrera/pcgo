---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { site } from '~/data/site';

const seo = {
  title: 'Página no encontrada — PCGO',
  description: 'La página que buscas no existe o se ha movido. Vuelve al inicio o contáctanos.',
  canonical: '/404',
  noindex: true,
} as const;
---

<BaseLayout seo={seo}>
  <main id="main">
    <section class="section">
      <div class="container container--narrow text-center">
        <p class="eyebrow reveal">Error 404</p>
        <h1 class="h-1 reveal" data-delay="1" style="margin-top:16px;">Esa página no existe.</h1>
        <p class="lead reveal" data-delay="2" style="margin-top:24px;">La URL que has abierto no apunta a nada. Vuelve al inicio o llámame y miro qué necesitas.</p>
        <div class="flex-center mt-4 reveal" data-delay="3" style="gap:14px;flex-wrap:wrap;">
          <a class="btn btn--primary btn--lg" href="/">Volver al inicio</a>
          <a class="btn btn--ghost btn--lg" href={`tel:${site.phone.tel}`}>Llamar ahora</a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
