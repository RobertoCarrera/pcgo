---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Hero from '~/components/Hero.astro';
import CTA from '~/components/CTA.astro';
import FAQ from '~/components/FAQ.astro';
import Icon from '~/components/Icon.astro';
import { site } from '~/data/site';
import { services } from '~/data/services';
import { zones } from '~/data/zones';

const seo = {
  title: 'Servicio Técnico Informático a Domicilio en Vilanova, Sitges y Garraf | PCGO',
  description:
    'Servicio técnico informático a domicilio en Vilanova i la Geltrú, Sitges y toda la comarca del Garraf. Reparación de PC, Mac, consolas, redes WiFi y soporte remoto en menos de 24 h. Desplazamiento incluido. ☎ 620 67 15 15',
  canonical: '/',
  includeGeo: true,
};

// FAQ schema for SEO
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: '¿Cuánto cuesta el servicio técnico a domicilio en Vilanova i la Geltrú?',
      acceptedAnswer: { '@type': 'Answer', text: 'Para particulares la tarifa es de 45 €/hora. Para empresas 50 €/hora, con descuentos progresivos en los PackGo! (3h a 49 €/h, 5h a 48 €/h, 10h a 46 €/h, 20h a 45 €/h). El desplazamiento está incluido en todo el Garraf.' },
    },
    {
      '@type': 'Question',
      name: '¿Cuánto tardáis en venir si tengo una urgencia?',
      acceptedAnswer: { '@type': 'Answer', text: 'Con la TarifaGo, en menos de 24 horas te visitamos en cualquier punto del Garraf. Para soporte remoto la primera hora cuesta 30 € y los tramos adicionales de 30 minutos 15 €, sin necesidad de esperar a un técnico.' },
    },
    {
      '@type': 'Question',
      name: '¿Trabajáis con productos Apple?',
      acceptedAnswer: { '@type': 'Answer', text: 'Sí. Más de 2 años como especialista Apple: configuración, reparación, migración de datos e integración con iCloud, iPhone, iPad y Mac. Para presupuestos de iPhone y Mac enlazamos con la herramienta oficial de Apple.' },
    },
    {
      '@type': 'Question',
      name: '¿Hacéis recogida y entrega del equipo?',
      acceptedAnswer: { '@type': 'Answer', text: 'Sí. En el servicio de Taller, la recogida y entrega está incluida en todo el territorio del Garraf sin coste adicional. La tarifa de taller es de 40 €/hora.' },
    },
    {
      '@type': 'Question',
      name: '¿Reparáis consolas y equipos vintage?',
      acceptedAnswer: { '@type': 'Answer', text: 'Sí. Reparamos PlayStation, Xbox, Nintendo y también consolas y equipos vintage (siempre que haya piezas o posibilidad de adaptación). Trato el equipo como si fuera mío.' },
    },
    {
      '@type': 'Question',
      name: '¿Cuáles son las zonas que cubrís?',
      acceptedAnswer: { '@type': 'Answer', text: 'Toda la comarca del Garraf (Vilanova i la Geltrú, Sitges, Sant Pere de Ribes, Cubelles, Canyelles, Olivella), Baix Penedès (Vilafranca, El Vendrell, Calafell, Cunit) y Alt Penedès. Desplazamiento incluido en Garraf; entre 25 y 50 km, 10 € adicionales.' },
    },
    {
      '@type': 'Question',
      name: '¿Qué formas de pago aceptáis?',
      acceptedAnswer: { '@type': 'Answer', text: 'Efectivo, tarjeta, Bizum y transferencia bancaria. Para soporte remoto se solicita un depósito previo antes de la asistencia.' },
    },
  ],
};

const breadcrumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Inicio', item: site.website }],
};

// Sample testimonials (hard-coded — could be moved to data/testimonials.ts if more)
const testimonials = [
  { stars: 5, text: '«Vino a casa en menos de 24h. Me dejó el Mac como nuevo y me explicó todo lo que había hecho. Profesional y honesto.»', author: 'Marta R., Vilanova i la Geltrú' },
  { stars: 5, text: '«Llevamos años confiando en Alberto para la red de la oficina. Rápido, razonable y siempre disponible. Una apuesta segura.»', author: 'Jordi P., Sitges' },
  { stars: 5, text: '«Nos configuró la WiFi de toda la casa sin zonas muertas. Y la clase con mi padre para aprender a usar el iPad fue un detallazo.»', author: 'Anna M., Sant Pere de Ribes' },
];
---

<BaseLayout seo={seo} jsonLd={[faqSchema, breadcrumbs]}>
  <main id="main">
    <Hero
      eyebrow="Servicio técnico · Vilanova · Sitges · Garraf"
      title={`Hacemos que la tecnología<br>trabaje <em style="font-style:normal;background:linear-gradient(135deg,#0071e3 0%,#5e5cff 100%);-webkit-background-clip:text;background-clip:text;color:transparent;">para ti</em>, no al revés.`}
      lead="Informático a domicilio en la comarca del Garraf y Baix Penedès. Reparación de PC, Mac, consolas y redes WiFi — con desplazamiento incluido y tarifa transparente desde 45 €/hora."
      ctas={[
        { label: `Llámanos: ${site.phone.display}`, href: `tel:${site.phone.tel}`, variant: 'primary', ariaLabel: `Llamar a PCGO al ${site.phone.display}` },
        { label: 'Escríbeme por WhatsApp', href: site.whatsapp, variant: 'ghost', external: true },
      ]}
      visual={`<div class="hero__visual-text">Servicio técnico honesto.<br>En tu casa, en tu negocio, o en remoto.</div>`}
    />

    <!-- STATS -->
    <section class="container" aria-label="Datos clave de PCGO">
      <div class="stats">
        {site.stats.map((s, i) => (
          <div class={`reveal`} data-delay={i + 1}>
            <div class="stat__num">{s.num}</div>
            <div class="stat__label">{s.label}</div>
          </div>
        ))}
      </div>
    </section>

    <!-- SERVICIOS -->
    <section class="section" id="servicios" aria-labelledby="serviciosTitle">
      <div class="container">
        <header class="section__head">
          <span class="eyebrow reveal">Lo que hacemos</span>
          <h2 id="serviciosTitle" class="h-2 reveal" data-delay="1">Servicio técnico, a tu manera</h2>
          <p class="lead reveal" data-delay="2">A domicilio, en tu negocio o en remoto. Tú eliges cómo quieres que te ayudemos. Cero sorpresas, cero letra pequeña: te explico el problema y el precio antes de empezar.</p>
        </header>
        <div class="grid grid--3">
          {services.map((s, i) => (
            <article class="card card--feature reveal" data-delay={(i % 6) + 1}>
              <div class="svc-icon" aria-hidden="true">
                <Icon name={s.icon} size={48} />
              </div>
              <h3 class="card__title">{s.name}</h3>
              <p class="card__desc">
                {s.slug === 'reparacion-ordenadores' && 'Diagnóstico, limpieza, sustitución de componentes, recuperación del sistema, eliminación de malware y aceleración de PCs que van lentos. Trato tu equipo como si fuera mío.'}
                {s.slug === 'soporte-apple' && 'Especialista en Mac, iPhone y iPad con más de 2 años de experiencia. Configuración inicial, migración entre equipos, iCloud, copias de seguridad y puesta a punto.'}
                {s.slug === 'redes-wifi' && 'WiFi sin zonas muertas, mesh, switches, cableado estructurado, configuración de routers y NAS. Mejoramos la señal de tu casa o montamos la red de tu negocio desde cero.'}
                {s.slug === 'reparacion-consolas' && 'PlayStation, Xbox, Nintendo y también equipos vintage cuando hay piezas. Cambios de pasta térmica, fuentes de alimentación, HDMI, lectores, baterías y todo lo que se rompa.'}
                {s.slug === 'venta-equipos' && 'PC Gaming, workstations, portátiles, barebones y dispositivos Apple. Te asesoro sin venderte humo: solo lo que necesitas, configurado y listo para usar desde el primer minuto.'}
                {s.slug === 'clases-personalizadas' && 'Uno-a-uno, a tu ritmo, sin tecnicismos. Desde manejar el smartphone hasta montar tu propio PC Gaming, pasando por copias de seguridad, correo, fotos o videollamadas con la familia.'}
              </p>
              <a class="card__link" href={`/servicios/${s.slug}`}>Ver detalle</a>
            </article>
          ))}
        </div>
        <div class="text-center mt-5 reveal">
          <a class="btn btn--outline" href="/tarifas">Ver tarifas completas <Icon name="arrow-right" size={16} strokeWidth={2.5} /></a>
        </div>
      </div>
    </section>

    <!-- VALORES -->
    <section class="section section--soft" aria-labelledby="valoresTitle">
      <div class="container">
        <header class="section__head">
          <span class="eyebrow reveal">Por qué PCGO</span>
          <h2 id="valoresTitle" class="h-2 reveal" data-delay="1">Honesto, rápido y con cariño.</h2>
          <p class="lead reveal" data-delay="2">Tres palabras que resumen cómo trabajo. Cero sorpresas en la factura, cero letra pequeña.</p>
        </header>
        <div class="grid grid--3">
          <div class="card reveal" data-delay="1">
            <div class="card__icon" aria-hidden="true"><Icon name="shield" size={28} strokeWidth={2} /></div>
            <h3 class="card__title">Transparencia total</h3>
            <p class="card__desc">Te explico el problema, te doy el precio y solo trabajo si tú dices que sí. Si algo cambia, te aviso antes de seguir.</p>
          </div>
          <div class="card reveal" data-delay="2">
            <div class="card__icon" aria-hidden="true"><Icon name="zap" size={28} strokeWidth={2} /></div>
            <h3 class="card__title">Rapidez real</h3>
            <p class="card__desc">TarifaGo: en menos de 24h te visitamos en cualquier punto del Garraf. Y si se puede resolver en remoto, en 30 minutos estás funcionando.</p>
          </div>
          <div class="card reveal" data-delay="3">
            <div class="card__icon" aria-hidden="true"><Icon name="heart" size={28} strokeWidth={2} /></div>
            <h3 class="card__title">Trato como propio</h3>
            <p class="card__desc">Trato cada equipo como si fuera mío. Por eso muchos clientes vuelven y me recomiendan a sus amigos y familia.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- PROCESO -->
    <section class="section" aria-labelledby="procesoTitle">
      <div class="container">
        <header class="section__head">
          <span class="eyebrow reveal">Cómo trabajamos</span>
          <h2 id="procesoTitle" class="h-2 reveal" data-delay="1">De la llamada al alta en 4 pasos</h2>
        </header>
        <div class="grid grid--4">
          {[
            { n: '01', title: 'Me escribes o llamas', desc: 'Cuéntame qué te pasa. Te respondo en menos de 2 horas (laborables). Sin formularios eternos.' },
            { n: '02', title: 'Diagnóstico y presupuesto', desc: 'Te explico el problema en cristiano y te doy un precio cerrado antes de tocar nada. Si no te convence, no hay compromiso.' },
            { n: '03', title: 'Reparación in situ o en remoto', desc: 'Voy a tu casa o negocio, o lo solucionamos por escritorio remoto. Lo que prefieras.' },
            { n: '04', title: 'Pago solo si funciona', desc: 'Si no se soluciona, no se cobra. Pago por Bizum, tarjeta, transferencia o efectivo, como te venga mejor.' },
          ].map((step, i) => (
            <div class="card reveal" data-delay={i + 1}>
              <div style="font-size:48px;font-weight:600;line-height:1;color:var(--c-accent);letter-spacing:-0.02em;margin-bottom:16px;">{step.n}</div>
              <h3 class="card__title">{step.title}</h3>
              <p class="card__desc">{step.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- TARIFAS TEASER -->
    <section class="section section--soft" aria-labelledby="tarifasTitle">
      <div class="container">
        <header class="section__head">
          <span class="eyebrow reveal">Tarifas</span>
          <h2 id="tarifasTitle" class="h-2 reveal" data-delay="1">Honestas, sin sorpresas</h2>
          <p class="lead reveal" data-delay="2">Tres tarifas claras. La que se ajuste a ti.</p>
        </header>
        <div class="grid grid--3">
          <article class="card card--price reveal" data-delay="1">
            <h3>Particulares</h3>
            <p class="muted" style="margin-top:8px;">Para ti, en casa</p>
            <div style="margin:24px 0;">
              <span class="card__price-amount">45</span><span class="card__price-unit">€/hora</span>
            </div>
            <ul class="card__price-features">
              <li><Icon name="check" size={18} /> Desplazamiento incluido en todo el Garraf</li>
              <li><Icon name="check" size={18} /> TarifaGo urgencia +20 €/h (menos 24h)</li>
              <li><Icon name="check" size={18} /> Diagnóstico sin compromiso</li>
            </ul>
            <a class="btn btn--ghost btn--block" href="/tarifas">Ver detalle</a>
          </article>

          <article class="card card--price card--price--featured reveal" data-delay="2">
            <span class="card__price-badge">Recomendado</span>
            <h3>Empresas</h3>
            <p class="muted" style="margin-top:8px;">Para tu negocio</p>
            <div style="margin:24px 0;">
              <span class="card__price-amount">50</span><span class="card__price-unit">€/hora</span>
            </div>
            <ul class="card__price-features">
              <li><Icon name="check" size={18} /> PackGo! con descuento desde 3h</li>
              <li><Icon name="check" size={18} /> Hasta 45 €/h con PackGo! 20h</li>
              <li><Icon name="check" size={18} /> Soporte continuado o por proyectos</li>
              <li><Icon name="check" size={18} /> Factura simplificada o completa</li>
            </ul>
            <a class="btn btn--block" style="background:#fff;color:#0071e3;" href="/tarifas#b2b">Ver packs B2B</a>
          </article>

          <article class="card card--price reveal" data-delay="3">
            <h3>Remoto</h3>
            <p class="muted" style="margin-top:8px;">Sin esperar al técnico</p>
            <div style="margin:24px 0;">
              <span class="card__price-amount">30</span><span class="card__price-unit">€ primera hora</span>
            </div>
            <ul class="card__price-features">
              <li><Icon name="check" size={18} /> Tramos adicionales: 15 € / 30 min</li>
              <li><Icon name="check" size={18} /> Resolvemos en pantalla, en minutos</li>
              <li><Icon name="check" size={18} /> Pago por adelantado · Bizum / tarjeta</li>
            </ul>
            <a class="btn btn--ghost btn--block" href="/tarifas#remoto">Ver tarifa remoto</a>
          </article>
        </div>
      </div>
    </section>

    <!-- ZONAS -->
    <section class="section" id="zonas" aria-labelledby="zonasTitle">
      <div class="container">
        <header class="section__head">
          <span class="eyebrow reveal">Cobertura</span>
          <h2 id="zonasTitle" class="h-2 reveal" data-delay="1">Toda la comarca del Garraf y Baix Penedès</h2>
          <p class="lead reveal" data-delay="2">Desplazamiento incluido en el Garraf. Desde 10 € adicionales para poblaciones a 25–50 km.</p>
        </header>

        <div class="marquee reveal" data-delay="1" aria-hidden="false">
          <div class="marquee__track">
            {[...zones.map((z) => z.name), ...zones.map((z) => z.name)].map((name) => (
              <span class="marquee__item">{name}</span>
            ))}
          </div>
        </div>

        <div class="grid grid--3 mt-5">
          {zones.slice(0, 6).map((z, i) => (
            <a class={`card reveal`} data-delay={(i % 6) + 1} href={`/zonas/${z.slug}`}>
              <h3 class="card__title">{z.name}</h3>
              <p class="card__desc">{z.intro}</p>
              <span class="card__link">Ver zona</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- TESTIMONIOS -->
    <section class="section section--soft" aria-labelledby="testTitle">
      <div class="container">
        <header class="section__head">
          <span class="eyebrow reveal">Clientes hablan</span>
          <h2 id="testTitle" class="h-2 reveal" data-delay="1">Lo que dicen por ahí</h2>
        </header>
        <div class="grid grid--3">
          {testimonials.map((t, i) => (
            <figure class="card reveal" data-delay={i + 1}>
              <div role="img" aria-label="5 estrellas" style="color:#ff9500;letter-spacing:2px;font-size:18px;">★★★★★</div>
              <blockquote style="margin-top:14px;font-size:17px;line-height:1.5;">{t.text}</blockquote>
              <figcaption style="margin-top:16px;font-weight:500;">— {t.author}</figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>

    <FAQ
      eyebrow="Preguntas frecuentes"
      title="Resolvemos tus dudas"
      faqs={[
        { q: '¿Cuánto cuesta el servicio a domicilio en Vilanova i la Geltrú?', a: 'Para particulares la tarifa es de 45 €/hora. Para empresas 50 €/hora, con descuentos progresivos en los PackGo! (3h a 49 €/h, 5h a 48 €/h, 10h a 46 €/h, 20h a 45 €/h). El desplazamiento está incluido en todo el Garraf.' },
        { q: '¿Cuánto tardáis si tengo una urgencia?', a: 'Con la TarifaGo, en menos de 24 horas te visitamos en cualquier punto del Garraf. Para soporte remoto la primera hora cuesta 30 € y los tramos adicionales de 30 minutos 15 €, sin necesidad de esperar a un técnico.' },
        { q: '¿Trabajáis con productos Apple?', a: 'Sí. Más de 2 años como especialista Apple: configuración, reparación, migración de datos e integración con iCloud, iPhone, iPad y Mac.' },
        { q: '¿Hacéis recogida y entrega del equipo?', a: 'Sí. En el servicio de Taller, la recogida y entrega está incluida en todo el territorio del Garraf sin coste adicional. La tarifa de taller es de 40 €/hora.' },
        { q: '¿Reparáis consolas y equipos vintage?', a: 'Sí. Reparamos PlayStation, Xbox, Nintendo y también consolas y equipos vintage (siempre que haya piezas).' },
        { q: '¿Cuáles son las zonas que cubrís?', a: 'Toda la comarca del Garraf (Vilanova, Sitges, Sant Pere de Ribes, Cubelles, Canyelles, Olivella), Baix Penedès (Vilafranca, El Vendrell, Calafell, Cunit) y Alt Penedès.' },
        { q: '¿Qué formas de pago aceptáis?', a: 'Efectivo, tarjeta, Bizum y transferencia bancaria. Para soporte remoto se solicita un depósito previo.' },
      ]}
    />

    <CTA
      title="¿Tienes un problema tecnológico?"
      lead="Te lo soluciono hoy mismo. Llámame o escríbeme por WhatsApp y lo vemos al momento."
      ctas={[
        { label: site.phone.display, href: `tel:${site.phone.tel}`, variant: 'primary' },
        { label: 'Abrir WhatsApp', href: site.whatsapp, variant: 'ghost', external: true },
      ]}
    />
  </main>
</BaseLayout>
