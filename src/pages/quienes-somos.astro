---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Hero from '~/components/Hero.astro';
import CTA from '~/components/CTA.astro';
import Icon from '~/components/Icon.astro';
import { site } from '~/data/site';

const seo = {
  title: 'Quién soy — Alberto Domínguez · PCGO Garraf',
  description:
    'Soy Alberto Domínguez, técnico informático en el Garraf. 10+ años arreglando PC, Mac, redes y servidores a domicilio en Vilanova, Sitges y Baix Penedès.',
  canonical: '/quienes-somos',
  includeGeo: true,
  ogType: 'profile' as const,
};

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.legalName,
  jobTitle: 'Técnico informático y especialista Apple',
  worksFor: { '@id': `${site.website}#localbusiness` },
  url: `${site.website}/quienes-somos`,
  sameAs: [site.instagram],
  knowsAbout: [
    'Reparación de hardware',
    'Reparación de Mac',
    'Reparación de iPhone',
    'Redes y WiFi',
    'Migración de datos',
    'Eliminación de malware',
  ],
};

const aboutSchema = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: 'Quiénes somos — PCGO',
  url: `${site.website}/quienes-somos`,
  isPartOf: { '@id': `${site.website}#website` },
  about: { '@id': `${site.website}#localbusiness` },
  inLanguage: 'es-ES',
};

const breadcrumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: site.website },
    { '@type': 'ListItem', position: 2, name: 'Quiénes somos', item: `${site.website}/quienes-somos` },
  ],
};
---

<BaseLayout seo={seo} jsonLd={[personSchema, aboutSchema, breadcrumbs]}>
  <main id="main">
    <Hero
      eyebrow="Quién soy"
      title={`Soy Alberto.<br><span class="text-gradient-blue">Informático</span> en el Garraf,<br>10 años arreglando PC y redes.`}
      lead="Empecé arreglando PC en una tienda de Sitges. Ahora voy a casas y oficinas del Garraf a arreglar lo que se rompe: PC, Mac, redes WiFi, servidores, Active Directory. Sin tienda, sin intermediarios, sin sorpresas en la factura."
    />

    <!-- STORY -->
    <section class="section" aria-labelledby="historiaTitle">
      <div class="container container--narrow">
        <article>
          <h2 id="historiaTitle" class="h-2 reveal">Cómo llegué hasta aquí</h2>
          <p class="lead reveal" data-delay="1" style="margin-top:16px;">Empecé en una tienda de informática. Ahora trabajo por mi cuenta, a domicilio.</p>

          <div class="reveal" data-delay="2" style="margin-top:32px;font-size:19px;line-height:1.65;color:var(--c-text-2);">
            <p>Soy <strong>Alberto Domínguez</strong>. llevo más de 10 años arreglando PC, Mac y redes. Los primeros años los pasé en una tienda de Sitges; los dos últimos me he especializado a fondo en el ecosistema Apple (Mac, iPhone, iPad, Apple TV, Time Machine, iCloud).</p>
            <p style="margin-top:16px;">PCGO es el paso natural: en vez de esperar a que el cliente venga a la tienda, <strong>voy yo a su casa o a su negocio</strong> con todo lo necesario. Resuelvo sobre la marcha lo que se pueda y me llevo el equipo al taller solo si hace falta. Es más cómodo para ti y, a menudo, más rápido y más barato.</p>
          </div>
        </article>
      </div>
    </section>

    <!-- FILOSOFIA -->
    <section class="section section--soft" aria-labelledby="filosofiaTitle">
      <div class="container">
        <header class="section__head">
          <span class="eyebrow reveal">Cómo se trabaja conmigo</span>
          <h2 id="filosofiaTitle" class="h-2 reveal" data-delay="1">Diagnóstico, precio y al lío.</h2>
          <p class="lead reveal" data-delay="2">Tres cosas que pasan en cada visita.</p>
        </header>
        <div class="grid grid--3">
          <div class="card reveal" data-delay="1">
            <div class="card__icon" aria-hidden="true"><Icon name="shield" size={28} strokeWidth={2} /></div>
            <h3 class="card__title">Te digo lo que tienes</h3>
            <p class="card__desc">Miro el equipo, te explico qué le pasa con palabras normales y te digo si merece la pena arreglarlo. Si no la merece, también te lo digo.</p>
          </div>
          <div class="card reveal" data-delay="2">
            <div class="card__icon" aria-hidden="true"><Icon name="chat" size={28} strokeWidth={2} /></div>
            <h3 class="card__title">Precio cerrado antes de tocar</h3>
            <p class="card__desc">Te paso presupuesto antes de hacer nada. Si la cosa se complica sobre la marcha, te llamo y te pido OK antes de seguir. Cero extras de última hora.</p>
          </div>
          <div class="card reveal" data-delay="3">
            <div class="card__icon" aria-hidden="true"><Icon name="lock" size={28} strokeWidth={2} /></div>
            <h3 class="card__title">Sin tecnicismos</h3>
            <p class="card__desc">Te explico en cristiano, no en jerga. Si quieres que te cuente detalles técnicos, los cuento, pero empiezo por lo que necesitas saber para decidir.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- LO QUE NO SOMOS -->
    <section class="section" aria-labelledby="noSomosTitle">
      <div class="container container--narrow">
        <h2 id="noSomosTitle" class="h-2 reveal">Lo que no hago</h2>
        <p class="lead reveal" data-delay="1" style="margin-top:12px;">Para que no te lleves sorpresas.</p>
        <div class="grid grid--2 mt-5">
          <div class="card reveal" data-delay="1" style="border-left:4px solid var(--c-danger);">
            <h3 class="card__title">No soy Apple Store</h3>
            <p class="card__desc">No tramito AppleCare+, no uso sus herramientas oficiales de diagnóstico, no sustituyo pantallas con piezas originales suyas. Para eso te envío a la tienda. Lo que sí hago: configuración, migración, reparación, recuperación de datos, Mac con virus.</p>
          </div>
          <div class="card reveal" data-delay="2" style="border-left:4px solid var(--c-danger);">
            <h3 class="card__title">No inflo presupuestos</h3>
            <p class="card__desc">Si tu PC necesita 30 minutos y vale 22 €, te cobro 22 €. Si necesita 2 horas, te digo antes que van a ser 2 horas. Sin extras ocultos ni "esto no lo esperábamos".</p>
          </div>
          <div class="card reveal" data-delay="3" style="border-left:4px solid var(--c-danger);">
            <h3 class="card__title">No vendo humo</h3>
            <p class="card__desc">No te voy a recomendar cambiar un equipo que tiene arreglo, ni a instalar un antivirus de 80 € al año cuando con el gratuito vas sobrado. Te digo lo que necesitas, no lo que me da más margen.</p>
          </div>
          <div class="card reveal" data-delay="4" style="border-left:4px solid var(--c-danger);">
            <h3 class="card__title">No prometo lo que no es</h3>
            <p class="card__desc">Si un disco duro está muerto, te lo digo. Si tus fotos son irrecuperables, te lo digo. Prefiero ser honesto ahora que dejarte con la miel en los labios.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- LO QUE SI HACEMOS -->
    <section class="section section--dark" aria-labelledby="siHacemosTitle">
      <div class="container">
        <header class="section__head">
          <span class="eyebrow reveal" style="color:#a1a1a6;">Lo que sí hago</span>
          <h2 id="siHacemosTitle" class="h-2 reveal" data-delay="1">Cifras y zonas</h2>
          <p class="lead reveal" data-delay="2">Lo que he hecho en estos 10 años, en datos.</p>
        </header>
        <div class="grid grid--3">
          <div class="card reveal" data-delay="1" style="background:#2c2c2e;border-color:#3a3a3c;">
            <div class="stat__num" style="background:linear-gradient(135deg,#fff 0%,#a1a1a6 100%);-webkit-background-clip:text;background-clip:text;">10+</div>
            <p style="color:#a1a1a6;margin-top:8px;">Años arreglando PC, Mac y redes en el Garraf</p>
          </div>
          <div class="card reveal" data-delay="2" style="background:#2c2c2e;border-color:#3a3a3c;">
            <div class="stat__num" style="background:linear-gradient(135deg,#fff 0%,#a1a1a6 100%);-webkit-background-clip:text;background-clip:text;">2+</div>
            <p style="color:#a1a1a6;margin-top:8px;">Años en exclusiva con Mac, iPhone y iPad</p>
          </div>
          <div class="card reveal" data-delay="3" style="background:#2c2c2e;border-color:#3a3a3c;">
            <div class="stat__num" style="background:linear-gradient(135deg,#fff 0%,#a1a1a6 100%);-webkit-background-clip:text;background-clip:text;">12</div>
            <p style="color:#a1a1a6;margin-top:8px;">Poblaciones cubiertas en Garraf y Penedès</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ACCESIBILIDAD -->
    <section class="section" aria-labelledby="compromisoTitle">
      <div class="container container--narrow">
        <h2 id="compromisoTitle" class="h-2 reveal">Si necesitas que me adapte a ti</h2>
        <p class="reveal" data-delay="1" style="margin-top:16px;font-size:19px;line-height:1.65;color:var(--c-text-2);">
          Si tienes movilidad reducida, dificultad visual, auditiva o cognitiva, dímelo cuando contactes. Preparo la visita para que todo fluya: herramientas, ritmo de explicación, apoyo de alguien si hace falta. No es un "compromiso con la accesibilidad" en plan marketing; es algo que hago sin coste extra cuando hace falta.
        </p>
      </div>
    </section>

    <!-- DATOS LEGALES -->
    <section class="section section--soft" aria-labelledby="legalTitle">
      <div class="container container--narrow">
        <h2 id="legalTitle" class="h-3 reveal">Datos del titular</h2>
        <div class="card reveal" data-delay="1" style="margin-top:24px;">
          <dl style="display:grid;grid-template-columns:auto 1fr;gap:12px 24px;font-size:17px;">
            <dt style="color:var(--c-text-2);">Titular</dt><dd style="margin:0;font-weight:500;">{site.legalName}</dd>
            <dt style="color:var(--c-text-2);">NIF</dt><dd style="margin:0;font-weight:500;">{site.nif}</dd>
            <dt style="color:var(--c-text-2);">Actividad</dt><dd style="margin:0;font-weight:500;">Servicios técnicos de informática y consultoría</dd>
            <dt style="color:var(--c-text-2);">Dirección</dt><dd style="margin:0;">{site.city}, {site.province} (España)</dd>
            <dt style="color:var(--c-text-2);">Teléfono</dt><dd style="margin:0;"><a href={`tel:${site.phone.tel}`}>{site.phone.display}</a></dd>
            <dt style="color:var(--c-text-2);">Email</dt><dd style="margin:0;"><a href={`mailto:info&#64;satpcgo&#46;es`}>info&#64;satpcgo.es</a></dd>
            <dt style="color:var(--c-text-2);">Web</dt><dd style="margin:0;"><a href={site.website}>{site.website.replace('https://', '')}</a></dd>
            <dt style="color:var(--c-text-2);">Instagram</dt><dd style="margin:0;"><a href={site.instagram} target="_blank" rel="noopener">@pcgo.ig</a></dd>
            <dt style="color:var(--c-text-2);">Horario</dt><dd style="margin:0;">Lunes a sábado · 09:00 a 20:00</dd>
          </dl>
        </div>
      </div>
    </section>

    <CTA
      title="¿Hablamos?"
      lead="Cuéntame qué necesitas. Te respondo en menos de 2 horas (laborables) y sin compromiso."
      ctas={[
        { label: site.phone.display, href: `tel:${site.phone.tel}`, variant: 'primary' },
        { label: 'WhatsApp', href: site.whatsapp, variant: 'ghost', external: true },
      ]}
    />
  </main>
</BaseLayout>
