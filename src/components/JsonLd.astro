---
/**
 * JsonLd.astro — safely render one or more JSON-LD objects.
 * Each item is JSON.stringify'd; multiple <script> tags for multiple objects.
 */
type Props = { data: object | object[] };
const { data } = Astro.props as Props;
const items = Array.isArray(data) ? data : [data];
---

{
  items.map((item) => (
    <script is:inline type="application/ld+json" set:html={JSON.stringify(item)} />
  ))
}
