---
/**
 * LiquidGlass.astro — Apple-style refractive glass card.
 * Uses the global SVG filter #liquid-glass defined in BaseLayout.
 * Place over a colorful/varied background to see the refractive effect.
 */
type Props = {
  variant?: 'light' | 'dark';
  class?: string;
  /** Inline padding, e.g. "32px" or "40px 32px". Default: 40px 36px. */
  padding?: string;
  /** Optional max-width */
  maxWidth?: string;
};
const {
  variant = 'light',
  class: className = '',
  padding = '40px 36px',
  maxWidth,
} = Astro.props as Props;
const cls = ['liquid-glass'];
if (variant === 'dark') cls.push('liquid-glass--dark');
if (className) cls.push(className);
---

<div class={cls.join(' ')} style={`padding:${padding};${maxWidth ? `max-width:${maxWidth};` : ''}`}>
  <slot />
</div>
