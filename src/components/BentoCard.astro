---
/**
 * BentoCard.astro — Apple-style bento card with hover-reveal CTA.
 * Ported from @magicui/bento-grid (MIT).
 * Styles live in src/styles/global.css (see .bento-card).
 *
 * Slot "visual" — decorative background element (optional).
 * Slot "icon"   — the leading icon.
 *
 * On hover:
 *   - the content block translates up by 2.5rem
 *   - the icon scales to 0.75
 *   - the CTA reveal slides in from the bottom
 *   - a subtle black/3 overlay fades in
 *
 * If `image` is provided, a heavily-blurred photo is rendered behind the
 * card content as a soft color field. The blur + scale prevent the photo
 * from competing with the text.
 */
type Props = {
  name: string;
  description: string;
  href: string;
  cta: string;
  class?: string;
  theme?: 'default' | 'dark' | 'blue' | 'tinted';
  image?: string;
};
const {
  name,
  description,
  href,
  cta,
  class: className = '',
  theme = 'default',
  image,
} = Astro.props as Props;
const themeClass = theme !== 'default' ? `bento-card--${theme}` : '';
---
<div class={`bento-card ${themeClass} ${className} ${image ? 'bento-card--has-image' : ''}`}>
  {image && (
    <div class="bento-card__bg" aria-hidden="true">
      <img src={image} alt="" loading="lazy" decoding="async" />
      <div class="bento-card__bg-overlay"></div>
    </div>
  )}
  <div class="bento-card__visual">
    <slot name="visual" />
  </div>
  <div class="bento-card__content">
    <div class="bento-card__icon">
      <slot name="icon" />
    </div>
    <h3 class="bento-card__name">{name}</h3>
    <p class="bento-card__desc">{description}</p>
  </div>
  <a class="bento-card__cta" href={href}>
    <span>{cta}</span>
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/>
    </svg>
  </a>
  <div class="bento-card__overlay" aria-hidden="true"></div>
</div>
